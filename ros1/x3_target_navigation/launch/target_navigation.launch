<launch>
  <arg name="config" default="$(find x3_target_navigation)/config/astra_pro.yaml"/>
  <arg name="model_path" default="$(env HOME)/models/object_detection_yolox_2022nov_opencv41.onnx"/>
  <!-- false rejects /target_navigation/confirm. Pass execute:=true for an attended run. -->
  <arg name="execute" default="false"/>
  <arg name="obstacle_stop_approach" default="true"/>
  <arg name="obstacle_bypass" default="false"/>
  <arg name="target_label" default="bottle"/>
  <arg name="start_astra" default="false"/>
  <arg name="start_bringup" default="false"/>
  <arg name="start_navigation" default="false"/>
  <arg name="map" default="my_map"/>
  <arg name="inference_rate" default="1.0"/>

  <!-- Runs before any device is opened. A second driver or MakerControl aborts the launch. -->
  <param name="x3_device_preflight"
         command="python $(find x3_target_navigation)/scripts/check_exclusive_devices.py $(arg start_bringup) $(arg start_astra)"/>

  <group if="$(arg start_bringup)">
    <include file="$(find x3_target_navigation)/launch/safe_bringup.launch">
      <arg name="require_navigation_permission" value="true"/>
      <arg name="velocity_topic" value="$(eval '/target_navigation/approach_velocity' if arg('obstacle_stop_approach') else '/cmd_vel')"/>
    </include>
    <node pkg="rplidar_ros" type="rplidarNode" name="rplidarNode"
          output="screen" required="true">
      <param name="serial_port" value="/dev/x3_lidar"/>
      <param name="serial_baudrate" type="int" value="115200"/>
      <param name="frame_id" value="laser"/>
      <param name="inverted" type="bool" value="false"/>
      <param name="angle_compensate" type="bool" value="true"/>
    </node>
    <node pkg="tf2_ros" type="static_transform_publisher"
          name="base_link_to_laser"
          args="0.0435 5.258E-05 0.11 3.1416 0 0 base_link laser"/>
  </group>

  <group if="$(arg start_astra)">
    <include file="$(find astra_camera)/launch/astra.launch">
      <arg name="depth_registration" value="true"/>
      <arg name="rgb_processing" value="false"/>
    </include>
    <group ns="camera">
      <node pkg="usb_cam" type="usb_cam_node" name="rgb" output="screen"
            required="true">
        <param name="video_device" value="/dev/x3_camera_rgb"/>
        <param name="image_width" value="640"/>
        <param name="image_height" value="480"/>
        <param name="pixel_format" value="yuyv"/>
        <param name="framerate" value="30"/>
        <param name="camera_frame_id" value="camera_rgb_optical_frame"/>
        <param name="camera_info_url"
               value="file:///home/jetson/.ros/camera_info/camera.yaml"/>
      </node>
    </group>
    <node pkg="topic_tools" type="throttle" name="rgb_inference_throttle"
          args="messages /camera/rgb/image_raw $(arg inference_rate) /camera/rgb/image_inference"
          output="screen" required="true"/>
  </group>

  <include if="$(arg start_navigation)"
           file="$(find x3_target_navigation)/launch/safe_navigation.launch">
    <arg name="map" value="$(arg map)"/>
    <arg name="start_move_base" value="true"/>
    <arg name="bypass_holonomic" value="$(arg obstacle_bypass)"/>
    <arg name="move_base_cmd_vel" value="$(eval '/target_navigation/bypass_nav_velocity' if arg('obstacle_bypass') == 'true' else ('/target_navigation/align_velocity' if arg('obstacle_stop_approach') == 'true' else '/cmd_vel'))"/>
  </include>

  <group ns="target_navigation">
    <rosparam command="load" file="$(arg config)"/>

    <node pkg="x3_target_navigation" type="rgbd_target_node"
          name="rgbd_target_node" output="screen" required="true">
      <param name="model_path" value="$(arg model_path)"/>
      <param name="target_label" value="$(arg target_label)"/>
      <remap from="raw_target" to="/target_navigation/raw_target"/>
      <remap from="visual_detection"
             to="/target_navigation/visual_detection"/>
    </node>

    <node pkg="x3_target_navigation" type="target_fusion_node"
          name="target_fusion_node" output="screen" required="true">
      <remap from="raw_target" to="/target_navigation/raw_target"/>
      <remap from="fused_target" to="/target_navigation/fused_target"/>
    </node>

    <node pkg="x3_target_navigation" type="target_task_manager"
          name="target_task_manager" output="screen" required="true">
      <param name="execute_enabled" value="$(arg execute)"/>
      <param name="obstacle_stop_approach" value="$(arg obstacle_stop_approach)"/>
      <param name="obstacle_bypass_enabled" value="$(arg obstacle_bypass)"/>
      <remap from="fused_target" to="/target_navigation/fused_target"/>
      <remap from="visual_detection"
             to="/target_navigation/visual_detection"/>
      <remap from="preview_goal" to="/target_navigation/preview_goal"/>
      <remap from="state" to="/target_navigation/state"/>
      <remap from="confirm" to="/target_navigation/confirm"/>
      <remap from="cancel" to="/target_navigation/cancel"/>
    </node>
  </group>
</launch>
